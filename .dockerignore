# Multi-stage Docker build for the Dekolife web application.
# Build context is the repository root, so nothing outside it can leak in.
.git
.github
.gitignore
.editorconfig
node_modules
vendor
public/build
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.env
.env.*
!.env.example
docs
input
*.md
!README.md
# `tests` is intentionally included: CI runs the gates inside this image with no bind
# mount, so the image must carry the test suite, phpunit.xml, pint.json and phpstan.neon.
.phpunit.result.cache
